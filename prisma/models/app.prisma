model ApplicationSettings {
    timestamp DateTime @id @default(now())

    metadataProviders String[]

    showGamePanelTextDecoration Boolean @default(true)
    serverName String @default("Drop")
    mLogoObjectId String?
}

enum Platform {
    Windows @map("windows")
    Linux   @map("linux")
    macOS   @map("macos")
}

enum LibraryBackend {
    Filesystem
    FlatFilesystem
}

model Library {
    id   String @id @default(uuid())
    name String

    backend LibraryBackend
    options Json

    // When true (default), the version-import pipeline runs the
    // `setupEmulators` phase (SSE detection + Goldberg achievement
    // scaffolding). Flip OFF to make that phase a FULL no-op for every
    // game in this library — no steam_settings/, no achievement DB sync.
    autoEmulatorSetup Boolean @default(true)

    games Game[]
}

model Depot {
    id       String @id @default(uuid())
    endpoint String
    key      String @default(uuid())
}

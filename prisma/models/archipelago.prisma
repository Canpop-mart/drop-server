/// Archipelago multiworld support.
///
/// Unlike co-op `Room`s (see room.prisma) these are NOT ephemeral: a multiworld
/// runs for days or weeks, so there is deliberately no `expiresAt`. The daily
/// `cleanup:archipelago` task only closes Setup sessions no member has used in
/// a long while (`lastActivityAt`) and deletes sessions that have been Closed
/// for a long while; Running sessions are never reaped. See
/// server/internal/archipelago/index.ts.
///
/// The other structural difference: co-op rooms mint one ZeroTier network each
/// and the server never joins them. Archipelago's server runs ON our machine, so
/// remote players need a routable address for it — hence ONE long-lived network
/// (`ArchipelagoNetwork`) that the server joins itself, giving it a stable
/// overlay IP. Sessions are told apart by Archipelago's per-room port, not by
/// network. See server/internal/archipelago/index.ts.

/// Singleton (one row): the shared Archipelago overlay network.
model ArchipelagoNetwork {
  /// Always "singleton" — enforces one row without needing a partial index.
  id String @id @default("singleton")

  /// The ZeroTier network id our controller minted for Archipelago (16 hex).
  networkId String @unique

  /// Third octet of this network's /24 (10.243.<octet>.0/24). Kept distinct
  /// from co-op's 10.242.x so the two can never collide.
  subnetOctet Int

  /// The server's own ZeroTier IPv4 on this network, as the controller node
  /// itself reports holding it after joining. It is only reachable by players
  /// if the Archipelago server shares that node's network (see the decision
  /// note in server/internal/archipelago/index.ts). Null until the node reports
  /// it; resolved by a later call. Rows written before that rule may hold the
  /// controller's intended address instead, so reads re-check it live.
  serverAddress String?

  createdAt DateTime @default(now())
}

enum ArchipelagoSessionStatus {
  /// Collecting YAMLs from members.
  Setup
  /// Seed generated and a room is hosted; `connectAddress` is set.
  Running
  /// Finished or abandoned; kept for reference.
  Closed
}

/// One multiworld: a group of players collecting YAMLs together, and (once
/// generated) the Archipelago room they connect to.
model ArchipelagoSession {
  id String @id @default(uuid())

  /// Short, human-shareable join code. Same alphabet/shape as Room.shortCode.
  shortCode String @unique

  name String?

  /// The `ip:port` players enter as `/connect` in their game's client. Pasted
  /// by the host from the Archipelago room page after generating, because the
  /// port is chosen by Archipelago per room (from its GAME_PORTS range).
  connectAddress String?

  status ArchipelagoSessionStatus @default(Setup)

  hostClientId String
  hostClient   Client @relation("ArchipelagoHost", fields: [hostClientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Last time a member did something with this session through Drop: joined
  /// or rejoined, opened or polled it, uploaded a YAML, or set the connect
  /// address. The reaper's idle clock for Setup sessions. Opening and polling
  /// move it forward at most once an hour, so polls don't write every time.
  lastActivityAt DateTime @default(now())

  slots ArchipelagoSlot[]

  @@index([hostClientId])
}

/// One player's slot in a session: their uploaded YAML plus what we parsed out
/// of it. One row per client device per session.
model ArchipelagoSlot {
  sessionId String
  session   ArchipelagoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation("ArchipelagoSlotClient", fields: [clientId], references: [id], onDelete: Cascade)

  /// The raw YAML exactly as uploaded. Stored verbatim (not re-serialised) so
  /// the bundle we hand to Archipelago is byte-identical to what the player
  /// wrote — re-emitting it risks changing semantics of game-specific options.
  yamlText String?

  /// Parsed from the YAML's `name` / `game` keys, for the readiness list and
  /// for duplicate-slot-name detection across the session.
  slotName String?
  game     String?

  /// Unused: an invalid YAML is rejected at upload and never stored, so this
  /// was only ever null. Kept so dropping it doesn't need a migration.
  validationError String?

  /// This device's ZeroTier node id (10 hex), recorded at join so the server
  /// can de-authorize it from the overlay when it leaves or the session closes.
  /// Null on slots joined before this was recorded; backfilled the next time
  /// that device joins or reconnects.
  memberId String?

  uploadedAt DateTime?
  joinedAt   DateTime  @default(now())

  @@id([sessionId, clientId])
  @@index([clientId])
}

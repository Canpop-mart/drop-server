enum MetadataSource {
  Manual
  GiantBomb
  Steam
  PCGamingWiki
  IGDB
  Metacritic
  OpenCritic
}

enum GameType {
  Game
  Emulator
  Dependency
  Mod
}

enum ControllerSupport {
  Full
  Partial
  None
}

model Game {
  id String @id @default(uuid())

  metadataSource MetadataSource
  metadataId     String
  created        DateTime       @default(now())

  type GameType @default(Game)

  // For type=Mod games: the base game this mod applies to. A mod is a Game with
  // its own versions/metadata/lifecycle; its files overlay into the parent's
  // install dir on the client. Null for normal games. Self-relation mirrors the
  // LaunchConfiguration emulator self-relation below.
  parentGameId String?
  parentGame   Game?   @relation("mods", fields: [parentGameId], references: [id], onDelete: SetNull)
  mods         Game[]  @relation("mods")
  // Mod placement lives per-VERSION now (GameVersion.modInstallDir +
  // launchOverride), set in the version import wizard so each version is
  // self-contained.

  // Any field prefixed with m is filled in from metadata
  // Acts as a cache so we can search and filter it
  mName String // Name of game

  mShortDescription String // Short description
  mDescription      String // Supports markdown
  mReleased         DateTime // When the game was released

  // Gamepad support level, from Steam's controller_support signal.
  mControllerSupport ControllerSupport @default(None)

  // HowLongToBeat completion times in minutes (best-effort enrichment).
  // Null when HLTB has no entry or the scrape failed at import time.
  mHltbMain          Int? // Main Story
  mHltbMainSides     Int? // Main + Extras
  mHltbCompletionist Int? // Completionist

  ratings GameRating[]

  featured        Boolean @default(false)
  updateAvailable Boolean @default(false)

  mIconObjectId           String // linked to objects in s3
  mBannerObjectId         String // linked to objects in s3
  mCoverObjectId          String
  mLogoObjectId           String @default("")
  mImageCarouselObjectIds String[] @default([]) // linked to below array
  mImageLibraryObjectIds  String[] // linked to objects in s3

  versions GameVersion[]

  // These fields will not be optional in the next version
  // Any game without a library ID will be assigned one at startup, based on the defaults
  libraryId   String
  library     Library @relation(fields: [libraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  libraryPath String

  // For multi-disc games: ordered list of actual disc folder names relative to
  // the library base dir. Empty for single-disc games.
  discFolders String[] @default([])

  collections CollectionEntry[]
  screenshots Screenshot[]
  tags        GameTag[]
  playtime      Playtime[]
  playSessions  PlaySession[]
  cloudSaves    CloudSave[]

  developers             Company[]               @relation(name: "developers")
  publishers             Company[]               @relation(name: "publishers")
  unimportedGameVersions UnimportedGameVersion[]
  gameRequests           GameRequest[]
  favoritedBy            FavoriteGame[]
  achievements           Achievement[]
  achievementResets      AchievementReset[]
  externalLinks          GameExternalLink[]
  externalHashes         GameExternalHash[]
  leaderboards           Leaderboard[]
  showcases              ProfileShowcase[]
  streamingSessions      StreamingSession[]
  clientInstalls         ClientInstalledGame[]
  compatibilityResults   GameCompatibilityResult[]
  versionRevisions       GameVersionRevision[]

  @@unique([metadataSource, metadataId], name: "metadataKey")
  @@unique([libraryId, libraryPath], name: "libraryKey")
  @@index([mName(ops: raw("gist_trgm_ops(siglen=32)"))], type: Gist)
  // Hot query on landing/home pages: `WHERE featured = true ORDER BY created`.
  // Without this, every featured-games fetch scans the whole Game table.
  // (libraryId is already covered by the (libraryId, libraryPath) unique
  // index — Postgres uses its leading column for equality lookups.)
  @@index([featured])
  // A mod's page lists its siblings via `WHERE parentGameId = ?`. Postgres does
  // not auto-index FK columns, so add it explicitly.
  @@index([parentGameId])
}

model GameTag {
  id   String @id @default(uuid())
  name String @unique

  games             Game[]
  weeklyChallenges  WeeklyChallenge[]

  @@index([name(ops: raw("gist_trgm_ops(siglen=32)"))], type: Gist)
}

model GameRating {
  id String @id @default(uuid())

  metadataSource MetadataSource
  metadataId     String
  created        DateTime       @default(now())

  mReviewCount  Int
  mReviewRating Float // 0 to 1

  mReviewHref String?

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId String

  @@unique([metadataSource, metadataId], name: "metadataKey")
  @@index([gameId])
}

model UnimportedGameVersion {
  id          String @id @default(uuid())
  gameId      String
  game        Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  versionName String

  manifest Json
  fileList String[]

  @@index([gameId])
}

// A particular set of files that relate to the version
model GameVersion {
  gameId    String
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  versionId String @id @default(uuid())

  displayName String?
  versionPath String?

  created DateTime @default(now())

  launches LaunchConfiguration[]
  setups   SetupConfiguration[]

  onlySetup Boolean @default(false)

  // Mod placement (type=Mod games only; set in the version import wizard).
  // modInstallDir: subdirectory, relative to the base game's install dir, that
  // this version's files overlay into. Empty = the install root. Handles both
  // a wrapper folder and the per-mod location, e.g. "Stardew Valley" (SMAPI) or
  // "Stardew Valley/Mods/StardewArchipelago".
  modInstallDir String @default("")
  // launchOverride: executable (relative to the install dir) to launch while
  // this mod version is installed, instead of the base game's normal one. Null
  // = no launch change. Reverts on uninstall.
  launchOverride String?

  dropletManifest  Json // Results from droplet
  fileList         String[] // List of all files, for delta updates
  negativeFileList String[] // List of files to remove, for delta updates

  // Persisted FULL (no-delta) sizes in bytes. The client version-list endpoint
  // reads these columns instead of re-parsing the manifest on every request —
  // that recompute raced the client's 15s timeout on a cold cache and made
  // installs flaky. Null on rows imported before this existed, and cleared
  // whenever the manifest is rewritten (gamesize invalidateGame); filled in
  // again the first time a size is computed for the row.
  installSize  BigInt?
  downloadSize BigInt?

  versionIndex Int
  delta        Boolean @default(false)

  // Content revision of this version's files (in-place updates). Starts at 1;
  // "Publish update" in the admin version editor bumps it after the folder is
  // edited and re-hashed under the same versionId. The per-file hashes of each
  // revision live in GameVersionRevision. Rows that existed before revisions
  // are revision 1; their snapshot is written only when an admin presses
  // "Record fingerprints" or "Check for changes" on the version.
  revision Int @default(1)

  // Mirrored folders (in-place updates): folders, relative to the version
  // root with "/" separators, that players' installs are made to match
  // exactly on update. The client lists any other file in them for the player
  // to keep or remove. Set in the admin version editor; the PUT normalizes it
  // (revisions/mirror.ts). Served to clients by the version files endpoint.
  // Empty = no mirroring.
  mirrorFolders String[] @default([])

  requiredContent  GameVersion[] @relation(name: "requiredContent")
  requiringContent GameVersion[] @relation(name: "requiredContent")

  importReceipt ImportReceipt?

  compatibilityResults GameCompatibilityResult[]

  // PostgreSQL does not auto-index FK columns. Without this, cascade deletes
  // from Game and every "list versions for this game" query full-scans the
  // table. The compound (gameId, versionIndex DESC) also covers the
  // "latest version for this game" lookup used at download time, which is a
  // hot query on the client sync path.
  @@index([gameId])
  @@index([gameId, versionIndex(sort: Desc)])
}

/// Per-file content hashes of one revision of a game version: the ground truth
/// for "what changed" between two revisions and the baseline a client compares
/// its install against (GET /api/v1/client/game/version/files).
///
/// Deliberately NOT related to GameVersion: a client may still need an old
/// revision of a version that has since been deleted, so the snapshot survives
/// the version row. It only goes away with the whole game.
model GameVersionRevision {
  id String @id @default(uuid())

  versionId String
  gameId    String
  game      Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  revision Int

  /// Array of { path, size, sha256 }, sorted by path. path is relative to the
  /// version root and equal to the manifest's filename (droplet uses the
  /// server OS's separator, so a backslash on a Windows-hosted library; clients
  /// normalise). sha256 is lowercase hex, or "" when it could not be
  /// established (the folder had already changed before the first snapshot
  /// was taken; see revisions/hash.ts).
  files Json

  /// Server-only stat cache, { [path]: [mtimeMs, ctimeMs, size, sha256] }:
  /// what the server last saw on disk for this version while this revision
  /// was current (written at hashing time and by "Check for changes"). A file
  /// whose stamp and size still match is not read again. Never sent to
  /// clients.
  fileStats Json @default("{}")

  createdAt DateTime @default(now())

  @@unique([versionId, revision])
  @@index([gameId])
}

/// Structured, queryable record of a single completed version import.
/// Written once at the end of `importVersion` (the persist phase). The
/// admin version detail page surfaces it so operators can see exactly
/// what happened: per-phase timings, file/chunk counts, whether a GBE
/// DLL swap was applied, and any non-fatal warnings collected en route.
///
/// One-to-one with GameVersion. Cascade-deleted with the version (and
/// explicitly deleted by the import-revert endpoint).
model ImportReceipt {
  id            String      @id @default(uuid())
  gameVersionId String      @unique
  gameVersion   GameVersion @relation(fields: [gameVersionId], references: [versionId], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  /// Phase timings captured via TaskRunContext.markPhase().
  /// Shape: [{ name: string, startedAt: ISO, endedAt: ISO, durationMs: number }]
  phaseTimingsJson Json

  fileCount      Int
  totalSizeBytes BigInt
  chunkCount     Int

  /// True if the import swapped a steam_api DLL for a GBE build.
  dllSwapApplied Boolean @default(false)
  /// Which DLL was swapped (e.g. "steam_api64.dll"), null when none.
  dllSwapName    String?

  /// Non-fatal warnings collected during the import.
  warnings String[] @default([])

  @@index([gameVersionId])
}

model SetupConfiguration {
  setupId String @id @default(uuid())

  command String

  platform Platform

  versionId   String
  gameVersion GameVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade, onUpdate: Cascade)
}

model LaunchConfiguration {
  launchId String @id @default(uuid())

  name String

  command String

  platform Platform

  // For emulation targets
  emulatorId          String?
  emulator            LaunchConfiguration? @relation(fields: [emulatorId], references: [launchId], name: "emulator")
  emulatorSuggestions String[]

  // Ordered disc image paths for multi-disc games (relative to game install dir).
  // Empty for single-disc games. When populated, the client generates a temporary
  // .m3u playlist at launch time and passes it to the emulator via {rom}.
  discPaths String[] @default([])

  umuIdOverride    String?
  umuStoreOverride String?

  versionId   String
  gameVersion GameVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade, onUpdate: Cascade)

  emulations LaunchConfiguration[] @relation("emulator")
}

model Screenshot {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  objectId String
  private  Boolean // if other users can see

  createdAt DateTime @default(now()) @db.Timestamptz(0)

  @@index([gameId, userId])
  @@index([userId])
}

model Playtime {
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  seconds Int // seconds user has spent playing the game

  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([gameId, userId])
  @@index([userId])
}

model PlaySession {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt       DateTime  @default(now()) @db.Timestamptz(6)
  endedAt         DateTime? @db.Timestamptz(6)
  durationSeconds Int?
  lastHeartbeatAt DateTime? @db.Timestamptz(6)

  @@index([gameId, userId])
  @@index([userId])
}

model Company {
  id String @id @default(uuid())

  metadataSource        MetadataSource
  metadataId            String
  metadataOriginalQuery String

  mName             String
  mShortDescription String
  mDescription      String
  mLogoObjectId     String
  mBannerObjectId   String
  mWebsite          String

  developed Game[] @relation(name: "developers")
  published Game[] @relation(name: "publishers")

  @@unique([metadataSource, metadataId], name: "metadataKey")
}

model ObjectHash {
  id   String @id
  hash String
}


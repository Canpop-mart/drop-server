DATABASE_URL="postgres://drop:drop@127.0.0.1:5432/drop"

GIANT_BOMB_API_KEY=""

# Required for fetching achievement definitions from Steam.
# Get a free key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""

EXTERNAL_URL="http://localhost:3000"

NUXT_PORT=4000

# --- ZeroTier co-op rooms (optional) ---
# Self-hosted ZeroTier controller that mints virtual-LAN networks for cross-
# internet co-op. Leave ZEROTIER_CONTROLLER_URL blank to disable the feature.
# See docs/zerotier-controller.md for the controller sidecar + first-boot steps.
ZEROTIER_CONTROLLER_URL=""
# The controller's authtoken.secret (paste inline after first boot). Alternatively
# set ZEROTIER_AUTH_TOKEN_PATH to a file the server can read.
ZEROTIER_AUTH_TOKEN=""
ZEROTIER_AUTH_TOKEN_PATH=""

# --- Archipelago WebHost (optional) ---
# The browser-openable URL of your Archipelago WebHost (the container that owns
# YAML generation + room hosting). When set, the client's Archipelago screen
# shows a link to it and a game search that deep-links to each game's options
# (YAML generator) page. Leave blank to hide those.
ARCHIPELAGO_WEBHOST_URL=""
